// KYC review queue data model.
// SQLite has no native enums, so role/status/risk values are plain strings
// validated in lib/auth.ts and lib/kyc-service.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Demo user. role: ANALYST | COMPLIANCE_LEAD | ADMIN
model User {
  id             String       @id
  name           String
  role           String
  assignedCases  KycCase[]    @relation("AssignedReviewer")
  escalatedCases KycCase[]    @relation("EscalatedBy")
  notes          ReviewNote[]
  auditEvents    AuditEvent[]
}

/// riskLevel: LOW | MEDIUM | HIGH
/// status: PENDING | IN_REVIEW | APPROVED | REJECTED | ESCALATED
model KycCase {
  id                 String       @id
  customerName       String
  dateOfBirth        String // synthetic, YYYY-MM-DD
  ssn                String // synthetic, 9xx-xx-xxxx (never issued by SSA)
  documentType       String
  riskLevel          String
  status             String       @default("PENDING")
  assignedReviewerId String?
  assignedReviewer   User?        @relation("AssignedReviewer", fields: [assignedReviewerId], references: [id])
  escalatedById      String?
  escalatedBy        User?        @relation("EscalatedBy", fields: [escalatedById], references: [id])
  notes              ReviewNote[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([status])
  @@index([riskLevel])
}

model ReviewNote {
  id        String   @id @default(cuid())
  caseId    String
  case      KycCase  @relation(fields: [caseId], references: [id])
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([caseId])
}

/// Append-only. No route updates or deletes rows. `changes` is JSON of
/// non-sensitive before/after values only (never SSN, DOB, or note text).
model AuditEvent {
  id           String   @id @default(cuid())
  actorId      String
  actor        User     @relation(fields: [actorId], references: [id])
  action       String
  resourceType String
  resourceId   String
  changes      String?
  createdAt    DateTime @default(now())

  @@index([resourceType, resourceId])
  @@index([createdAt])
}
